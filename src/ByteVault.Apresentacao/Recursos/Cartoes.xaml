<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Estilo de Cartão de Métrica (Dashboard) -->
    <Style x:Key="EstiloCartaoMetrica" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PincelSuperficieElevada}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaioBordaCartao}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="6" />
    </Style>

    <!-- Estilo de Cartão de Conteúdo (Lista / Itens) -->
    <Style x:Key="EstiloCartaoConteudo" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PincelSuperficieElevada}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaioBordaCartao}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Estilo de Badge / Etiqueta de Tag -->
    <Style x:Key="EstiloBadgeTag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PincelSuperficieSecundaria}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaioBordaTag}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

</ResourceDictionary>
