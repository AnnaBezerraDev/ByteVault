<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Base ByteVault OLED Midnight -->
    <Color x:Key="CorFundoPrincipal">#000000</Color>
    <Color x:Key="CorBarraLateral">#090A0D</Color>
    <Color x:Key="CorSuperficieElevada">#111318</Color>
    <Color x:Key="CorSuperficieSecundaria">#181B22</Color>
    <Color x:Key="CorBorda">#242834</Color>
    <Color x:Key="CorBordaFoco">#5B7EFA</Color>

    <!-- Cores de Texto -->
    <Color x:Key="CorTextoPrincipal">#FFFFFF</Color>
    <Color x:Key="CorTextoSecundario">#A2A8BA</Color>
    <Color x:Key="CorTextoDesabilitado">#626778</Color>

    <!-- Cores de Destaque e Status -->
    <Color x:Key="CorDestaquePrimaria">#5B7EFA</Color>
    <Color x:Key="CorDestaqueHover">#7998FF</Color>
    <Color x:Key="CorSucesso">#45D08E</Color>
    <Color x:Key="CorAtencao">#E8B86D</Color>
    <Color x:Key="CorErro">#FF5C5C</Color>

    <!-- Pincéis (Brushes) -->
    <SolidColorBrush x:Key="PincelFundoPrincipal" Color="#000000" />
    <SolidColorBrush x:Key="PincelBarraLateral" Color="#090A0D" />
    <SolidColorBrush x:Key="PincelSuperficieElevada" Color="#111318" />
    <SolidColorBrush x:Key="PincelSuperficieSecundaria" Color="#181B22" />
    <SolidColorBrush x:Key="PincelBorda" Color="#242834" />
    <SolidColorBrush x:Key="PincelBordaFoco" Color="#5B7EFA" />

    <SolidColorBrush x:Key="PincelTextoPrincipal" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PincelTextoSecundario" Color="#A2A8BA" />
    <SolidColorBrush x:Key="PincelTextoDesabilitado" Color="#626778" />

    <SolidColorBrush x:Key="PincelDestaquePrimaria" Color="#5B7EFA" />
    <SolidColorBrush x:Key="PincelDestaqueHover" Color="#7998FF" />
    <SolidColorBrush x:Key="PincelSucesso" Color="#45D08E" />
    <SolidColorBrush x:Key="PincelAtencao" Color="#E8B86D" />
    <SolidColorBrush x:Key="PincelErro" Color="#FF5C5C" />

</ResourceDictionary>
