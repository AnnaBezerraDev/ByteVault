<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Base ByteVault Light Studio -->
    <Color x:Key="CorFundoPrincipal">#F5F6FA</Color>
    <Color x:Key="CorBarraLateral">#EBEDF3</Color>
    <Color x:Key="CorSuperficieElevada">#FFFFFF</Color>
    <Color x:Key="CorSuperficieSecundaria">#E2E5EC</Color>
    <Color x:Key="CorBorda">#D2D6E0</Color>
    <Color x:Key="CorBordaFoco">#4E72FF</Color>

    <!-- Cores de Texto -->
    <Color x:Key="CorTextoPrincipal">#151822</Color>
    <Color x:Key="CorTextoSecundario">#555C6E</Color>
    <Color x:Key="CorTextoDesabilitado">#9AA0B0</Color>

    <!-- Cores de Destaque e Status -->
    <Color x:Key="CorDestaquePrimaria">#3B65F5</Color>
    <Color x:Key="CorDestaqueHover">#2850DE</Color>
    <Color x:Key="CorSucesso">#28A745</Color>
    <Color x:Key="CorAtencao">#D9822B</Color>
    <Color x:Key="CorErro">#E03E3E</Color>

    <!-- Pincéis (Brushes) -->
    <SolidColorBrush x:Key="PincelFundoPrincipal" Color="#F5F6FA" />
    <SolidColorBrush x:Key="PincelBarraLateral" Color="#EBEDF3" />
    <SolidColorBrush x:Key="PincelSuperficieElevada" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PincelSuperficieSecundaria" Color="#E2E5EC" />
    <SolidColorBrush x:Key="PincelBorda" Color="#D2D6E0" />
    <SolidColorBrush x:Key="PincelBordaFoco" Color="#4E72FF" />

    <SolidColorBrush x:Key="PincelTextoPrincipal" Color="#151822" />
    <SolidColorBrush x:Key="PincelTextoSecundario" Color="#555C6E" />
    <SolidColorBrush x:Key="PincelTextoDesabilitado" Color="#9AA0B0" />

    <SolidColorBrush x:Key="PincelDestaquePrimaria" Color="#3B65F5" />
    <SolidColorBrush x:Key="PincelDestaqueHover" Color="#2850DE" />
    <SolidColorBrush x:Key="PincelSucesso" Color="#28A745" />
    <SolidColorBrush x:Key="PincelAtencao" Color="#D9822B" />
    <SolidColorBrush x:Key="PincelErro" Color="#E03E3E" />

</ResourceDictionary>
