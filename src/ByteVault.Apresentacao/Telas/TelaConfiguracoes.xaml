<UserControl x:Class="ByteVault.Apresentacao.Telas.TelaConfiguracoes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            
            <!-- Cabeçalho -->
            <TextBlock Text="Configurações &amp; Sobre" Style="{StaticResource EstiloTituloPagina}" Margin="0,0,0,4" />
            <TextBlock Text="Personalização de preferências, caminhos de dados e informações do sistema" Style="{StaticResource EstiloTextoAuxiliar}" Margin="0,0,0,24" />

            <!-- Toast de Salvamento -->
            <Border Background="{DynamicResource PincelSucesso}"
                    CornerRadius="{StaticResource RaioBordaPadrao}"
                    Padding="14,8"
                    Margin="0,0,0,16"
                    Visibility="{Binding SalvoComSucesso, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="Configurações persistidas com sucesso!" Foreground="#FFFFFF" FontWeight="Medium" />
            </Border>

            <!-- Seção: Aparência -->
            <Border Style="{StaticResource EstiloCartaoMetrica}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Aparência Visual" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Tema da Interface" Style="{StaticResource EstiloTituloRegistro}" />
                            <TextBlock Text="Alterne instantaneamente entre o tema Escuro, Claro ou OLED Meia-Noite" Style="{StaticResource EstiloTextoAuxiliar}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🌙 Escuro"
                                    Command="{Binding SelecionarTemaCommand}"
                                    CommandParameter="Escuro"
                                    Style="{StaticResource EstiloBotaoSecundario}"
                                    Margin="0,0,8,0" Padding="12,6" />
                            <Button Content="☀️ Claro"
                                    Command="{Binding SelecionarTemaCommand}"
                                    CommandParameter="Claro"
                                    Style="{StaticResource EstiloBotaoSecundario}"
                                    Margin="0,0,8,0" Padding="12,6" />
                            <Button Content="🌑 Meia-Noite"
                                    Command="{Binding SelecionarTemaCommand}"
                                    CommandParameter="Meia-Noite"
                                    Style="{StaticResource EstiloBotaoSecundario}"
                                    Padding="12,6" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cor de Destaque Primária" Style="{StaticResource EstiloTituloRegistro}" />
                            <TextBlock Text="Código Hexadecimal da cor de destaque dos botões e seleções" Style="{StaticResource EstiloTextoAuxiliar}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource EstiloCampoTexto}" Text="{Binding Configuracao.CorDestaque, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Densidade Visual" Style="{StaticResource EstiloTituloRegistro}" />
                            <TextBlock Text="Espaçamento entre cartões e densidade de informação" Style="{StaticResource EstiloTextoAuxiliar}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource EstiloCampoTexto}" Text="{Binding Configuracao.DensidadeVisual, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Seção: Comportamento -->
            <Border Style="{StaticResource EstiloCartaoMetrica}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Comportamento da Aplicação" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,12" />

                    <CheckBox Style="{StaticResource EstiloCheckBox}"
                              IsChecked="{Binding Configuracao.ConfirmarExclusao, UpdateSourceTrigger=PropertyChanged}"
                              Content="Solicitar confirmação antes de excluir qualquer registro"
                              Margin="0,0,0,12" />

                    <CheckBox Style="{StaticResource EstiloCheckBox}"
                              IsChecked="{Binding Configuracao.SalvarAutomaticamente, UpdateSourceTrigger=PropertyChanged}"
                              Content="Habilitar salvamento automático de anotações" />
                </StackPanel>
            </Border>

            <!-- Seção: Dados e Armazenamento Local -->
            <Border Style="{StaticResource EstiloCartaoMetrica}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Armazenamento Local &amp; Persistência" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,12" />

                    <TextBlock Text="Caminho do Banco SQLite (%LOCALAPPDATA%\BYTEVAULT\Dados\)" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding CaminhoBancoDados}" IsReadOnly="True" Margin="0,0,0,12" />

                    <TextBlock Style="{StaticResource EstiloMetadados}" Margin="0,0,0,12">
                        <Run Text="Último Backup Realizado: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                        <Run Text="{Binding Configuracao.DataUltimoBackup, TargetNullValue='Nenhum backup realizado ainda'}" />
                    </TextBlock>

                    <!-- Ações de Backup e Pasta -->
                    <WrapPanel Margin="0,0,0,16">
                        <Button Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding CriarBackupAgoraCommand}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaSalvar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Criar Backup Agora (.zip)" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding AbrirPastaDadosCommand}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaPastaAberta}" Fill="{DynamicResource PincelTextoPrincipal}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir Pasta de Dados no Explorer" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Seção de Portabilidade de Dados -->
                    <TextBlock Text="Exportação e Portabilidade de Dados" Style="{StaticResource EstiloTituloRegistro}" Margin="0,8,0,8" />
                    <WrapPanel>
                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding ExportarJsonCommand}" Margin="0,0,8,8">
                            <TextBlock Text="Exportar Tudo em JSON" />
                        </Button>
                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding ExportarMarkdownCommand}" Margin="0,0,8,8">
                            <TextBlock Text="Exportar Notas (.md)" />
                        </Button>
                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding ExportarSnippetsTxtCommand}" Margin="0,0,8,8">
                            <TextBlock Text="Exportar Snippets (.txt)" />
                        </Button>
                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding ExportarCsvCommand}" Margin="0,0,8,8">
                            <TextBlock Text="Exportar Projetos (.csv)" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Seção: Sobre -->
            <Border Style="{StaticResource EstiloCartaoMetrica}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Sobre o BYTEVAULT" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,8" />
                    <TextBlock Text="BYTEVAULT — Ambiente Pessoal de Produtividade para Engenharia de Software" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,0,4" />
                    <TextBlock Text="Desenvolvido como aplicativo Windows 100% nativo em C# 13, .NET 10 LTS, WPF, SQLite, Entity Framework Core e Arquitetura em Camadas (MVVM)."
                               Style="{StaticResource EstiloTextoNormal}"
                               Foreground="{DynamicResource PincelTextoSecundario}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Style="{StaticResource EstiloMetadados}">
                        <Run Text="Versão do Esquema: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                        <Run Text="{Binding Configuracao.VersaoEsquema}" />
                        <Run Text="  •  Runtime: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                        <Run Text="{Binding VersaoApp}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Botão Salvar -->
            <Button Style="{StaticResource EstiloBotaoPrimario}"
                    HorizontalAlignment="Left"
                    Command="{Binding SalvarConfiguracoesCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconeGeometriaSalvar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="Salvar Alterações de Configuração" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
