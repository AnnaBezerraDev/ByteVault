<Window x:Class="ByteVault.Apresentacao.Telas.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ByteVault.Apresentacao.ModelosDeTela"
        xmlns:views="clr-namespace:ByteVault.Apresentacao.Telas"
        xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
        mc:Ignorable="d"
        Title="BYTEVAULT — Engenharia e Produtividade Pessoal"
        Icon="/Recursos/app.ico"
        Height="780" Width="1240"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PincelFundoPrincipal}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidadeInvertida" Inverter="True" />

        <!-- Mapeamento MVVM: ViewModel -> View -->
        <DataTemplate DataType="{x:Type vm:ModeloTelaDashboard}">
            <views:TelaDashboard />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaProjetos}">
            <views:TelaProjetos />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaSnippets}">
            <views:TelaSnippets />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaComandos}">
            <views:TelaComandos />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaAnotacoes}">
            <views:TelaAnotacoes />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaBugs}">
            <views:TelaBugs />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaTags}">
            <views:TelaTags />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaFavoritos}">
            <views:TelaFavoritos />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModeloTelaConfiguracoes}">
            <views:TelaConfiguracoes />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Layout Geral com 3 Colunas: Sidebar, Conteúdo, e Modal Flutuante -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. BARRA LATERAL ESQUERDA (SIDEBAR) -->
        <Border Grid.Column="0"
                Background="{DynamicResource PincelBarraLateral}"
                BorderBrush="{DynamicResource PincelBorda}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logotipo / Nome do App -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" Background="{DynamicResource PincelDestaquePrimaria}" CornerRadius="6" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconeGeometriaSnippets}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="BYTEVAULT" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PincelTextoPrincipal}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Cofre de Engenharia" Style="{StaticResource EstiloMetadados}" Margin="36,2,0,0" />
                </StackPanel>

                <!-- Menu de Navegação Vertical (9 Seções Obrigatórias) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,10">

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     IsChecked="True"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Painel">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaPainel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Painel (Dashboard)" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Projetos">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaProjetos}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Projetos" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Snippets">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaSnippets}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Trechos de Código" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Comandos">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaComandos}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Comandos CLI" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Anotacoes">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaAnotacoes}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Anotações Markdown" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Bugs">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaBugs}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Diário de Bugs" />
                            </StackPanel>
                        </RadioButton>

                        <Separator Background="{DynamicResource PincelBorda}" Margin="16,8" Height="1" />

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Tags">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaTags}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Tags Globais" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Favoritos">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaFavoritos}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Favoritos" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource EstiloBotaoMenuLateral}"
                                     GroupName="MenuLateral"
                                     Command="{Binding NavegarParaCommand}"
                                     CommandParameter="Configuracoes">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaConfiguracoes}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Configurações" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>

                <!-- Rodapé da Sidebar: Atalho Rápido de Pesquisa -->
                <Border Grid.Row="2" Padding="12,14" BorderBrush="{DynamicResource PincelBorda}" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource EstiloBotaoSecundario}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding AbrirPesquisaGlobalCommand}"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelTextoSecundario}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="Pesquisar..." Style="{StaticResource EstiloTextoAuxiliar}" />
                            <Border Grid.Column="2" Background="{DynamicResource PincelSuperficieElevada}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="Ctrl+K" Style="{StaticResource EstiloMetadados}" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- 2. ÁREA DE CONTEÚDO PRINCIPAL DIREITA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho Superior -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PincelBarraLateral}"
                    BorderBrush="{DynamicResource PincelBorda}"
                    BorderThickness="0,0,0,1"
                    Padding="24,12"
                    MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Título Dinâmico da Página Ativa -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TelaAtual.Titulo}" Style="{StaticResource EstiloTituloSecao}" />
                    </StackPanel>

                    <!-- Ações Rápidas no Cabeçalho (Tema, Tela Cheia, Pesquisa Global) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Alternar Tema -->
                        <Button Style="{StaticResource EstiloBotaoSecundario}"
                                Click="BotaoAlternarTema_Click"
                                ToolTip="Alternar Tema (Escuro, Claro, Meia-Noite)"
                                Margin="0,0,8,0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaTemaSol}" Fill="{DynamicResource PincelDestaquePrimaria}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Tema" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Alternar Tela Cheia / Maximizar -->
                        <Button Style="{StaticResource EstiloBotaoSecundario}"
                                Click="BotaoAlternarTelaCheia_Click"
                                ToolTip="Alternar Tela Cheia / Maximizar (Atalho: F11 ou duplo-clique no topo)"
                                Margin="0,0,8,0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaTelaCheia}" Fill="{DynamicResource PincelTextoPrincipal}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Tela Cheia" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Atalho Pesquisa no Cabeçalho -->
                        <Button Style="{StaticResource EstiloBotaoSecundario}"
                                Command="{Binding AbrirPesquisaGlobalCommand}"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Pesquisa Global" FontSize="12" Margin="0,0,8,0" />
                                <Border Background="{DynamicResource PincelFundoPrincipal}" CornerRadius="3" Padding="4,1">
                                    <TextBlock Text="Ctrl+K" Style="{StaticResource EstiloMetadados}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Área Dinâmica de Conteúdo (ContentPresenter renderiza a View via ViewModel) -->
            <ContentPresenter Grid.Row="1" Content="{Binding TelaAtual}" />

            <!-- Barra de Status Inferior -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PincelBarraLateral}"
                    BorderBrush="{DynamicResource PincelBorda}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource PincelSucesso}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding MensagemStatus}" Style="{StaticResource EstiloMetadados}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="SQLite Local  •  BYTEVAULT v1.0.0" Style="{StaticResource EstiloMetadados}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 3. POPUP MODAL DE PESQUISA GLOBAL (CTRL+K) -->
        <Border Grid.ColumnSpan="2"
                Background="#B308090C"
                Visibility="{Binding PopupPesquisaAberto, Converter={StaticResource BoolParaVisibilidade}}"
                Panel.ZIndex="1000">
            <Border Width="640"
                    MaxHeight="480"
                    Background="{DynamicResource PincelSuperficieElevada}"
                    BorderBrush="{DynamicResource PincelBordaFoco}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RaioBordaCartao}"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Campo de Busca -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelDestaquePrimaria}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 x:Name="CampoPesquisaGlobal"
                                 Style="{StaticResource EstiloCampoTexto}"
                                 Text="{Binding TermoPesquisaGlobal, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15"
                                 Padding="10,8" />
                        <Button Grid.Column="2" Style="{StaticResource EstiloBotaoIcone}" Command="{Binding FecharPesquisaGlobalCommand}" Margin="8,0,0,0">
                            <Path Data="{StaticResource IconeGeometriaFechar}" Fill="{DynamicResource PincelTextoSecundario}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Resultados da Busca -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ResultadosPesquisaGlobal}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EstiloCartaoConteudo}" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelecionarResultadoPesquisaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource EstiloTituloRegistro}" />
                                            <TextBlock Text="{Binding Descricao}" Style="{StaticResource EstiloTextoAuxiliar}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Style="{StaticResource EstiloBadgeTag}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tipo}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelDestaquePrimaria}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Rodapé com dicas de atalho -->
                    <TextBlock Grid.Row="2" Text="Use [Esc] para fechar ou clique em um resultado para navegar." Style="{StaticResource EstiloMetadados}" Margin="0,12,0,0" Foreground="{DynamicResource PincelTextoDesabilitado}" />
                </Grid>
            </Border>
        </Border>

    </Grid>
</Window>
