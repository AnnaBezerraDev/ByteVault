<UserControl x:Class="ByteVault.Apresentacao.Telas.TelaSnippets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
             xmlns:ctrl="clr-namespace:ByteVault.Apresentacao.Controles"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidadeInvertida" Inverter="True" />
        <conv:ConversorDataPtBr x:Key="DataPtBr" />
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Toast de Confirmação de Cópia -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource PincelSucesso}"
                CornerRadius="{StaticResource RaioBordaPadrao}"
                Padding="16,8"
                Margin="0,0,10,0"
                Panel.ZIndex="999"
                Visibility="{Binding ExibindoAvisoCopiado, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconeGeometriaCheck}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                <TextBlock Text="Código copiado para a área de transferência!" FontWeight="Medium" Foreground="#FFFFFF" />
            </StackPanel>
        </Border>

        <!-- Modo Lista -->
        <Grid Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Trechos de Código (Snippets)" Style="{StaticResource EstiloTituloPagina}" />
                    <TextBlock Text="Seu cofre de algoritmos, scripts reutilizáveis e snippets multilinguagem" Style="{StaticResource EstiloTextoAuxiliar}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding NovoSnippetCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Novo Snippet" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Barra de Filtros -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource EstiloCampoTexto}"
                         Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0" />

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding PesquisarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Filtrar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Lista de Snippets -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Snippets}"
                     SelectedItem="{Binding SnippetSelecionado}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EstiloCartaoConteudo}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Topo do Cartão -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,12,0" />
                                        <Border Style="{StaticResource EstiloBadgeTag}">
                                            <TextBlock Text="{Binding Linguagem}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelDestaquePrimaria}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource EstiloBotaoSecundario}"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.CopiarCodigoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Copiar Código">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconeGeometriaCopiar}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Copiar" FontSize="11" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.DuplicarSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Duplicar">
                                            <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="{DynamicResource PincelTextoSecundario}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.AlternarFavoritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Favoritar">
                                            <Path Data="{StaticResource IconeGeometriaFavoritos}"
                                                  Fill="{Binding EhFavorito, Converter={StaticResource BoolParaVisibilidade}}"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.EditarSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Editar">
                                            <Path Data="{StaticResource IconeGeometriaSalvar}" Fill="{DynamicResource PincelTextoSecundario}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.ExcluirSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Excluir">
                                            <Path Data="{StaticResource IconeGeometriaExcluir}" Fill="{DynamicResource PincelErro}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Visualização do Código -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource PincelFundoPrincipal}"
                                        BorderBrush="{DynamicResource PincelBorda}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RaioBordaPequeno}"
                                        Padding="12"
                                        Margin="0,0,0,8"
                                        MaxHeight="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding Codigo}"
                                                   Style="{StaticResource EstiloCodigo}"
                                                   FontFamily="{StaticResource FonteCodigo}"
                                                   Foreground="{DynamicResource PincelTextoPrincipal}" />
                                    </ScrollViewer>
                                </Border>

                                <!-- Rodapé com Metadados -->
                                <TextBlock Grid.Row="2" Style="{StaticResource EstiloMetadados}">
                                    <Run Text="{Binding Descricao, TargetNullValue='Sem descrição'}" />
                                    <Run Text="  •  Atualizado em: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                    <Run Text="{Binding DataAtualizacao, Converter={StaticResource DataPtBr}}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Modo Edição / Criação de Snippet -->
        <Border Background="{DynamicResource PincelSuperficieElevada}"
                BorderBrush="{DynamicResource PincelBorda}"
                BorderThickness="1"
                CornerRadius="{StaticResource RaioBordaCartao}"
                Padding="24"
                Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidade}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Editor de Snippet" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,16" />

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Título do Trecho *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding SnippetEmEdicao.Titulo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Linguagem *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding SnippetEmEdicao.Linguagem, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Código Fonte (Realce de Sintaxe com AvalonEdit) *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    
                    <Border BorderBrush="{DynamicResource PincelBorda}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RaioBordaPequeno}"
                            Height="300"
                            Margin="0,0,0,12">
                        <ctrl:EditorCodigoAvalon Texto="{Binding SnippetEmEdicao.Codigo, Mode=TwoWay}"
                                                Linguagem="{Binding SnippetEmEdicao.Linguagem}" />
                    </Border>

                    <TextBlock Text="Descrição / Observações de Uso" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding SnippetEmEdicao.Descricao, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding CancelarEdicaoCommand}" Content="Cancelar" Margin="0,0,10,0" />
                    <Button Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding SalvarEdicaoCommand}" Content="Salvar Snippet" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
