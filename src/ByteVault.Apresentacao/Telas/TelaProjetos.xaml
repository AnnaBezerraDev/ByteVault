<UserControl x:Class="ByteVault.Apresentacao.Telas.TelaProjetos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidadeInvertida" Inverter="True" />
        <conv:ConversorDataPtBr x:Key="DataPtBr" />
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Modo Lista -->
        <Grid Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho da Seção -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Projetos de Software" Style="{StaticResource EstiloTituloPagina}" />
                    <TextBlock Text="Gerencie seus repositórios, pastas locais, documentações e tecnologias" Style="{StaticResource EstiloTextoAuxiliar}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding NovoProjetoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Novo Projeto" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Barra de Filtros -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource EstiloCampoTexto}"
                         Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0" />

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding PesquisarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Filtrar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Lista de Projetos -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Projetos}"
                     SelectedItem="{Binding ProjetoSelecionado}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EstiloCartaoConteudo}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Nome}" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,12,0" />
                                        <Border Style="{StaticResource EstiloBadgeTag}">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelDestaquePrimaria}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Descricao}" Style="{StaticResource EstiloTextoNormal}" Foreground="{DynamicResource PincelTextoSecundario}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource EstiloMetadados}">
                                        <Run Text="Tecnologias: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                        <Run Text="{Binding LinguagensTecnologias, TargetNullValue='Nenhuma informada'}" />
                                        <Run Text="  •  Atualizado em: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                        <Run Text="{Binding DataAtualizacao, Converter={StaticResource DataPtBr}}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.AbrirPastaNoExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Abrir pasta local no Explorer">
                                        <Path Data="{StaticResource IconeGeometriaPastaAberta}" Fill="{DynamicResource PincelTextoSecundario}" Width="16" Height="16" Stretch="Uniform" />
                                    </Button>

                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.AbrirUrlRepositorioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Abrir Repositório Git">
                                        <Path Data="{StaticResource IconeGeometriaLinkExterno}" Fill="{DynamicResource PincelTextoSecundario}" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>

                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.AlternarFavoritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Favoritar Projeto">
                                        <Path Data="{StaticResource IconeGeometriaFavoritos}"
                                              Fill="{Binding EhFavorito, Converter={StaticResource BoolParaVisibilidade}}"
                                              Width="16" Height="16" Stretch="Uniform" />
                                    </Button>

                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.EditarProjetoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Editar Projeto">
                                        <Path Data="{StaticResource IconeGeometriaSalvar}" Fill="{DynamicResource PincelTextoSecundario}" Width="16" Height="16" Stretch="Uniform" />
                                    </Button>

                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.ExcluirProjetoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Excluir Projeto">
                                        <Path Data="{StaticResource IconeGeometriaExcluir}" Fill="{DynamicResource PincelErro}" Width="16" Height="16" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Modo Edição / Criação de Projeto -->
        <Border Background="{DynamicResource PincelSuperficieElevada}"
                BorderBrush="{DynamicResource PincelBorda}"
                BorderThickness="1"
                CornerRadius="{StaticResource RaioBordaCartao}"
                Padding="24"
                Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidade}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Dados do Projeto" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,16" />

                    <TextBlock Text="Nome do Projeto *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ProjetoEmEdicao.Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Descrição" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ProjetoEmEdicao.Descricao, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />

                    <TextBlock Text="Linguagens e Tecnologias (separadas por vírgula)" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ProjetoEmEdicao.LinguagensTecnologias, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Caminho Local da Pasta" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ProjetoEmEdicao.CaminhoLocal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="URL do Repositório" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ProjetoEmEdicao.UrlRepositorio, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="URL da Documentação" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ProjetoEmEdicao.UrlDocumentacao, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Observações Adicionais" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ProjetoEmEdicao.Observacoes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding CancelarEdicaoCommand}" Content="Cancelar" Margin="0,0,10,0" />
                        <Button Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding SalvarEdicaoCommand}" Content="Salvar Projeto" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
