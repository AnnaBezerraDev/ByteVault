<UserControl x:Class="ByteVault.Apresentacao.Telas.TelaBugs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidadeInvertida" Inverter="True" />
        <conv:ConversorDataPtBr x:Key="DataPtBr" />
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Modo Lista -->
        <Grid Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Diário de Bugs &amp; Soluções" Style="{StaticResource EstiloTituloPagina}" />
                    <TextBlock Text="Registre erros enfrentados, logs de stack trace e o caminho exato de como foram solucionados" Style="{StaticResource EstiloTextoAuxiliar}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding NovoBugCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Registrar Novo Bug" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Barra de Filtros -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource EstiloCampoTexto}"
                         Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0" />

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding PesquisarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Filtrar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Lista de Bugs -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Bugs}"
                     SelectedItem="{Binding BugSelecionado}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EstiloCartaoConteudo}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Topo do Cartão de Bug -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,12,0" />
                                        <Border Style="{StaticResource EstiloBadgeTag}">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelAtencao}" />
                                        </Border>
                                        <Border Style="{StaticResource EstiloBadgeTag}">
                                            <TextBlock Text="{Binding Severidade, StringFormat='Sev: {0}'}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelErro}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource EstiloBotaoSecundario}"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.AlternarStatusResolvidoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Alternar status do bug (Aberto > Investigando > Resolvido > Não Resolvido)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconeGeometriaCheck}" Fill="{DynamicResource PincelSucesso}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Mudar Status" FontSize="11" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.AlternarFavoritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Favoritar">
                                            <Path Data="{StaticResource IconeGeometriaFavoritos}"
                                                  Fill="{Binding EhFavorito, Converter={StaticResource BoolParaVisibilidade}}"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.EditarBugCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Editar">
                                            <Path Data="{StaticResource IconeGeometriaSalvar}" Fill="{DynamicResource PincelTextoSecundario}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.ExcluirBugCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Excluir">
                                            <Path Data="{StaticResource IconeGeometriaExcluir}" Fill="{DynamicResource PincelErro}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Erro e Solução -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <Border Background="{DynamicResource PincelSuperficieSecundaria}" BorderBrush="{DynamicResource PincelErro}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding MensagemErroOriginal, TargetNullValue='Nenhuma mensagem de erro registrada'}"
                                                   Style="{StaticResource EstiloTextoNormal}"
                                                   FontFamily="{StaticResource FonteCodigo}"
                                                   Foreground="{DynamicResource PincelErro}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <Border Background="{DynamicResource PincelSuperficieSecundaria}" BorderBrush="{DynamicResource PincelSucesso}" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <TextBlock Text="{Binding Solucao, TargetNullValue='Solução ainda em investigação...'}"
                                                   Style="{StaticResource EstiloTextoNormal}"
                                                   Foreground="{DynamicResource PincelSucesso}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>

                                <!-- Metadados -->
                                <TextBlock Grid.Row="2" Style="{StaticResource EstiloMetadados}">
                                    <Run Text="Tecnologia: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                    <Run Text="{Binding TecnologiaRelacionada, TargetNullValue='Geral'}" />
                                    <Run Text="  •  Atualizado em: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                    <Run Text="{Binding DataAtualizacao, Converter={StaticResource DataPtBr}}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Modo Edição / Criação de Bug -->
        <Border Background="{DynamicResource PincelSuperficieElevada}"
                BorderBrush="{DynamicResource PincelBorda}"
                BorderThickness="1"
                CornerRadius="{StaticResource RaioBordaCartao}"
                Padding="24"
                Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidade}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Registro de Bug / Problema Técnico" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,16" />

                    <TextBlock Text="Título do Bug *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding BugEmEdicao.Titulo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Mensagem de Erro Original / Stack Trace" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}"
                             Text="{Binding BugEmEdicao.MensagemErroOriginal, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource FonteCodigo}"
                             Height="90"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Solução Técnica Aplicada" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}"
                             Text="{Binding BugEmEdicao.Solucao, UpdateSourceTrigger=PropertyChanged}"
                             Height="90"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,12" />

                    <!-- Status e Severidade -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status do Bug *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <ComboBox Style="{StaticResource EstiloComboBox}"
                                      ItemsSource="{Binding ListaStatusBug}"
                                      SelectedItem="{Binding BugEmEdicao.Status, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Severidade *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <ComboBox Style="{StaticResource EstiloComboBox}"
                                      ItemsSource="{Binding ListaSeveridadesBug}"
                                      SelectedItem="{Binding BugEmEdicao.Severidade, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tecnologia Relacionada" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding BugEmEdicao.TecnologiaRelacionada, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ambiente (ex: Windows 11, WSL, Docker)" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding BugEmEdicao.Ambiente, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Snippets de Solução Vinculados -->
                    <TextBlock Text="Trechos de Código de Solução Vinculados (Relacionamento N:N)" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource PincelSuperficieSecundaria}" BorderBrush="{DynamicResource PincelBorda}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SnippetsVinculados}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource EstiloBadgeTag}" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Titulo}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelDestaquePrimaria}" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource EstiloBotaoIcone}"
                                                        Padding="2"
                                                        Command="{Binding DataContext.DesvincularSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remover vínculo">
                                                    <Path Data="{StaticResource IconeGeometriaFechar}" Fill="{DynamicResource PincelErro}" Width="8" Height="8" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ComboBox ItemsSource="{Binding SnippetsDisponiveis}"
                                      DisplayMemberPath="Titulo"
                                      SelectedItem="{Binding SnippetSelecionadoParaVincular, Mode=TwoWay}"
                                      Style="{StaticResource EstiloComboBox}"
                                      Margin="0,6,0,0"
                                      ToolTip="Selecione um snippet para vincular">
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding CancelarEdicaoCommand}" Content="Cancelar" Margin="0,0,10,0" />
                        <Button Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding SalvarEdicaoCommand}" Content="Salvar Bug" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
