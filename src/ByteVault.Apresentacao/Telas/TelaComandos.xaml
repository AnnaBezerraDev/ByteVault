<UserControl x:Class="ByteVault.Apresentacao.Telas.TelaComandos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidadeInvertida" Inverter="True" />
        <conv:ConversorDataPtBr x:Key="DataPtBr" />
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Toast de Confirmação de Cópia -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource PincelSucesso}"
                CornerRadius="{StaticResource RaioBordaPadrao}"
                Padding="16,8"
                Margin="0,0,10,0"
                Panel.ZIndex="999"
                Visibility="{Binding ExibindoAvisoCopiado, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconeGeometriaCheck}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                <TextBlock Text="Comando copiado para a área de transferência!" FontWeight="Medium" Foreground="#FFFFFF" />
            </StackPanel>
        </Border>

        <!-- Modo Lista -->
        <Grid Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Comandos de Terminal &amp; CLI" Style="{StaticResource EstiloTituloPagina}" />
                    <TextBlock Text="Biblioteca rápida de comandos para Git, PowerShell, Docker, .NET, Linux e ferramentas" Style="{StaticResource EstiloTextoAuxiliar}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding NovoComandoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Novo Comando" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Barra de Filtros -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource EstiloCampoTexto}"
                         Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0" />

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding PesquisarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Filtrar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Lista de Comandos -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Comandos}"
                     SelectedItem="{Binding ComandoSelecionado}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EstiloCartaoConteudo}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Linha 1: Título e Ações -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,12,0" />
                                        <Border Style="{StaticResource EstiloBadgeTag}">
                                            <TextBlock Text="{Binding FerramentaOuAmbiente}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelDestaquePrimaria}" />
                                        </Border>
                                        <Border Style="{StaticResource EstiloBadgeTag}">
                                            <TextBlock Text="{Binding SistemaOperacional}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelSucesso}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource EstiloBotaoSecundario}"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.CopiarComandoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Copiar Comando">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconeGeometriaCopiar}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Copiar" FontSize="11" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.DuplicarComandoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Duplicar">
                                            <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="{DynamicResource PincelTextoSecundario}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.AlternarFavoritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Favoritar">
                                            <Path Data="{StaticResource IconeGeometriaFavoritos}"
                                                  Fill="{Binding EhFavorito, Converter={StaticResource BoolParaVisibilidade}}"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.EditarComandoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Editar">
                                            <Path Data="{StaticResource IconeGeometriaSalvar}" Fill="{DynamicResource PincelTextoSecundario}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>

                                        <Button Style="{StaticResource EstiloBotaoIcone}"
                                                Command="{Binding DataContext.ExcluirComandoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Excluir">
                                            <Path Data="{StaticResource IconeGeometriaExcluir}" Fill="{DynamicResource PincelErro}" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Linha 2: Texto do Comando com visual de Console -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource PincelFundoPrincipal}"
                                        BorderBrush="{DynamicResource PincelBorda}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RaioBordaPequeno}"
                                        Padding="10,8"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding TextoComando}"
                                               FontFamily="{StaticResource FonteCodigo}"
                                               FontSize="13"
                                               Foreground="{DynamicResource PincelSucesso}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- Linha 3: Descrição e Metadados -->
                                <TextBlock Grid.Row="2" Style="{StaticResource EstiloMetadados}">
                                    <Run Text="{Binding Descricao, TargetNullValue='Sem descrição'}" />
                                    <Run Text="  •  Atualizado em: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                    <Run Text="{Binding DataAtualizacao, Converter={StaticResource DataPtBr}}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Modo Edição / Criação de Comando -->
        <Border Background="{DynamicResource PincelSuperficieElevada}"
                BorderBrush="{DynamicResource PincelBorda}"
                BorderThickness="1"
                CornerRadius="{StaticResource RaioBordaCartao}"
                Padding="24"
                Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidade}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Dados do Comando" Style="{StaticResource EstiloTituloSecao}" Margin="0,0,0,16" />

                    <TextBlock Text="Título do Comando *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ComandoEmEdicao.Titulo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Texto do Comando *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}"
                             Text="{Binding ComandoEmEdicao.TextoComando, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource FonteCodigo}"
                             Height="70"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ferramenta / Ambiente *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ComandoEmEdicao.FerramentaOuAmbiente, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sistema Operacional" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ComandoEmEdicao.SistemaOperacional, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Parâmetros e Flags Explicados" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ComandoEmEdicao.Parametros, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />

                    <TextBlock Text="Exemplo de Utilização" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ComandoEmEdicao.ExemploUtilizacao, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding CancelarEdicaoCommand}" Content="Cancelar" Margin="0,0,10,0" />
                        <Button Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding SalvarEdicaoCommand}" Content="Salvar Comando" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
