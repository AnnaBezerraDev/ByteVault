<UserControl x:Class="ByteVault.Apresentacao.Telas.TelaAnotacoes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
             xmlns:ctrl="clr-namespace:ByteVault.Apresentacao.Controles"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidadeInvertida" Inverter="True" />
        <conv:ConversorDataPtBr x:Key="DataPtBr" />
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Modo Lista -->
        <Grid Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Anotações &amp; Documentação Técnica" Style="{StaticResource EstiloTituloPagina}" />
                    <TextBlock Text="Central de documentação pessoal com suporte a formatação Markdown" Style="{StaticResource EstiloTextoAuxiliar}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding NovaAnotacaoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Nova Anotação" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Barra de Filtros -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource EstiloCampoTexto}"
                         Text="{Binding FiltroTermo, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0" />

                <Button Grid.Column="1" Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding PesquisarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconeGeometriaPesquisa}" Fill="{DynamicResource PincelTextoPrincipal}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Filtrar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Lista de Anotações -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Anotacoes}"
                     SelectedItem="{Binding AnotacaoSelecionada}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EstiloCartaoConteudo}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,12,0" />
                                        <Border Style="{StaticResource EstiloBadgeTag}">
                                            <TextBlock Text="{Binding Categoria, TargetNullValue='Geral'}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelDestaquePrimaria}" />
                                        </Border>
                                    </StackPanel>

                                    <Border Background="{DynamicResource PincelSuperficieSecundaria}" BorderBrush="{DynamicResource PincelBorda}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8" MaxHeight="100">
                                        <TextBlock Text="{Binding Conteudo}" Style="{StaticResource EstiloTextoNormal}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PincelTextoSecundario}" />
                                    </Border>

                                    <TextBlock Style="{StaticResource EstiloMetadados}">
                                        <Run Text="Projeto: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                        <Run Text="{Binding NomeProjeto, TargetNullValue='Geral'}" />
                                        <Run Text="  •  Atualizado em: " Foreground="{DynamicResource PincelTextoDesabilitado}" />
                                        <Run Text="{Binding DataAtualizacao, Converter={StaticResource DataPtBr}}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.AlternarFavoritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Favoritar">
                                        <Path Data="{StaticResource IconeGeometriaFavoritos}"
                                              Fill="{Binding EhFavorito, Converter={StaticResource BoolParaVisibilidade}}"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>

                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.EditarAnotacaoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Editar">
                                        <Path Data="{StaticResource IconeGeometriaSalvar}" Fill="{DynamicResource PincelTextoSecundario}" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>

                                    <Button Style="{StaticResource EstiloBotaoIcone}"
                                            Command="{Binding DataContext.ExcluirAnotacaoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Excluir">
                                        <Path Data="{StaticResource IconeGeometriaExcluir}" Fill="{DynamicResource PincelErro}" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Modo Edição / Criação de Anotação -->
        <Border Background="{DynamicResource PincelSuperficieElevada}"
                BorderBrush="{DynamicResource PincelBorda}"
                BorderThickness="1"
                CornerRadius="{StaticResource RaioBordaCartao}"
                Padding="24"
                Visibility="{Binding EmModoEdicao, Converter={StaticResource BoolParaVisibilidade}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Editor de Documentação Markdown" Style="{StaticResource EstiloTituloSecao}" />
                    <TextBlock Grid.Column="1" Text="{Binding EstadoSalvamento}" Style="{StaticResource EstiloMetadados}" Foreground="{DynamicResource PincelDestaquePrimaria}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Título *" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding AnotacaoEmEdicao.Titulo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Categoria" Style="{StaticResource EstiloMetadados}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding AnotacaoEmEdicao.Categoria, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Conteúdo Markdown *" Style="{StaticResource EstiloMetadados}" />
                        <Button Grid.Column="1" Style="{StaticResource EstiloBotaoSecundario}" Padding="8,2" Command="{Binding AlternarModoPreVisualizacaoCommand}">
                            <TextBlock Text="{Binding ModoPreVisualizacao, Converter={StaticResource BoolParaVisibilidadeInvertida}, StringFormat='Alternar Visualização'}" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Editor de Texto Markdown -->
                    <TextBox Style="{StaticResource EstiloCampoTexto}"
                             Text="{Binding AnotacaoEmEdicao.Conteudo, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource FonteCodigo}"
                             FontSize="13"
                             Height="300"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding ModoPreVisualizacao, Converter={StaticResource BoolParaVisibilidadeInvertida}}" />

                    <!-- Modo Pré-visualização com Renderizador Markdown Real (Markdig) -->
                    <Border Background="{DynamicResource PincelFundoPrincipal}"
                            BorderBrush="{DynamicResource PincelBorda}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RaioBordaPadrao}"
                            Height="300"
                            Visibility="{Binding ModoPreVisualizacao, Converter={StaticResource BoolParaVisibilidade}}">
                        <ctrl:VisualizadorMarkdown ConteudoMarkdown="{Binding AnotacaoEmEdicao.Conteudo}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource EstiloBotaoSecundario}" Command="{Binding CancelarEdicaoCommand}" Content="Cancelar" Margin="0,0,10,0" />
                    <Button Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding SalvarEdicaoCommand}" Content="Salvar Anotação" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
