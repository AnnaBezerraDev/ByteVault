<UserControl x:Class="ByteVault.Apresentacao.Telas.TelaTags"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ByteVault.Apresentacao.Conversores"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ConversorBooleanoVisibilidade x:Key="BoolParaVisibilidade" />
        <conv:ConversorDataPtBr x:Key="DataPtBr" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Gerenciamento de Tags" Style="{StaticResource EstiloTituloPagina}" />
            <TextBlock Text="Tags unificadas para organização transversal de projetos, snippets, comandos e documentações" Style="{StaticResource EstiloTextoAuxiliar}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Formulário de Criação Rápida de Tag -->
        <Border Grid.Row="1"
                Background="{DynamicResource PincelSuperficieElevada}"
                BorderBrush="{DynamicResource PincelBorda}"
                BorderThickness="1"
                CornerRadius="{StaticResource RaioBordaCartao}"
                Padding="16"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Cadastrar Nova Tag" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource EstiloCampoTexto}"
                             Text="{Binding NovaTagNome, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Column="2"
                             Style="{StaticResource EstiloCampoTexto}"
                             Text="{Binding NovaTagCor, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Cor hexadecimal (ex: #6C8CFF)" />

                    <Button Grid.Column="4" Style="{StaticResource EstiloBotaoPrimario}" Command="{Binding CriarTagCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconeGeometriaAdicionar}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Adicionar Tag" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Mensagem de Erro de Duplicação -->
                <TextBlock Text="{Binding MensagemErro}"
                           Foreground="{DynamicResource PincelErro}"
                           Style="{StaticResource EstiloTextoAuxiliar}"
                           Margin="0,8,0,0"
                           Visibility="{Binding MensagemErro, Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </Border>

        <!-- Lista de Tags Existentes -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Tags}"
                 SelectedItem="{Binding TagSelecionada}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource EstiloCartaoConteudo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="12" Height="12" CornerRadius="6" Background="{Binding CorHex}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Nome, StringFormat='#{0}'}" Style="{StaticResource EstiloTituloRegistro}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding TotalUsos, StringFormat='{}{0} itens vinculados'}" Style="{StaticResource EstiloTextoAuxiliar}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource EstiloBotaoIcone}"
                                    Command="{Binding DataContext.ExcluirTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Excluir Tag (Remove vínculos, preserva registros)">
                                <Path Data="{StaticResource IconeGeometriaExcluir}" Fill="{DynamicResource PincelErro}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
